; CHECK-LABEL: far_memmove:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    sub r0, #2
; CHECK-NEXT:    .cfi_def_cfa_offset 2
; CHECK-NEXT:    mov r6, [r0+#2]
; CHECK-NEXT:    mov [r0], r6
; CHECK-NEXT:    calla cc_UC, __memmove_far
; CHECK-NEXT:    add r0, #2
; CHECK-NEXT:    .cfi_def_cfa r0, 0
; CHECK-NEXT:    ret
  call void @llvm.memmove.p1.p1.i16(ptr addrspace(1) %d, ptr addrspace(1) %s, i16 %n, i1 false)
  ret void
}

define void @far_memset(ptr addrspace(1) %d, i8 %c, i16 %n) {
; CHECK-LABEL: far_memset:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    and r4, #255
; CHECK-NEXT:    calla cc_UC, __memset_far
; CHECK-NEXT:    ret
  call void @llvm.memset.p1.i16(ptr addrspace(1) %d, i8 %c, i16 %n, i1 false)
  ret void
}

; A move that stays near is untouched.
define void @near_memcpy(ptr %d, ptr %s, i16 %n) {
; CHECK-LABEL: near_memcpy:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    calla cc_UC, memcpy
; CHECK-NEXT:    ret
  call void @llvm.memcpy.p0.p0.i16(ptr %d, ptr %s, i16 %n, i1 false)
  ret void
}
