; FP-LABEL: locals:
; FP:       ; %bb.0:
; FP-NEXT:    sub r0, #22
; FP-NEXT:    .cfi_def_cfa_offset 22
; FP-NEXT:    mov [r0+#20], r1 ; 2-byte Folded Spill
; FP-NEXT:    mov r1, r0
; FP-NEXT:    .cfi_def_cfa_register r1
; FP-NEXT:    mov r2, r1
; FP-NEXT:    calla cc_UC, use
; FP-NEXT:    mov r0, r1
; FP-NEXT:    mov r1, [r0+#20] ; 2-byte Folded Reload
; FP-NEXT:    add r0, #22
; FP-NEXT:    .cfi_def_cfa r0, 0
; FP-NEXT:    ret
  %p = alloca [10 x i16]
  call void @use(ptr %p)
  ret void
}

