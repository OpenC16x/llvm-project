; A tail call jumps to the callee once this function's frame is gone, so the
; callee's RET goes straight back to our caller and no return address is ever
; pushed onto the small hardware stack.

declare i16 @callee(i16, i16)
declare void @vcallee()
declare i16 @many(i16, i16, i16, i16, i16, i16)
declare i16 @far_callee(i16) #1

define i16 @simple(i16 %a, i16 %b) {
; CHECK-LABEL: simple:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    jmpa cc_UC, callee
  %r = tail call i16 @callee(i16 %a, i16 %b)
  ret i16 %r
}

define void @returns_void() {
; CHECK-LABEL: returns_void:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    jmpa cc_UC, vcallee
  tail call void @vcallee()
  ret void
}

; The frame comes down in front of the jump.
define i16 @with_frame(i16 %a) {
; CHECK-LABEL: with_frame:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    sub r0, #2
; CHECK-NEXT:    .cfi_def_cfa_offset 2
; CHECK-NEXT:    mov [r0], r2
; CHECK-NEXT:    mov r3, #1
; CHECK-NEXT:    add r0, #2
; CHECK-NEXT:    .cfi_def_cfa r0, 0
; CHECK-NEXT:    jmpa cc_UC, callee
  %p = alloca i16
  store i16 %a, ptr %p
  %v = load i16, ptr %p
  %r = tail call i16 @callee(i16 %v, i16 1)
  ret i16 %r
}

define i16 @indirect(ptr %f, i16 %a) {
; CHECK-LABEL: indirect:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov r4, r2
; CHECK-NEXT:    mov r2, r3
; CHECK-NEXT:    mov r3, #2
; CHECK-NEXT:    jmpi cc_UC, [r4]
  %r = tail call i16 %f(i16 %a, i16 2)
  ret i16 %r
}

; A call whose result is used again is not in tail position.
define i16 @not_in_tail_position(i16 %a) {
; CHECK-LABEL: not_in_tail_position:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov r3, #1
; CHECK-NEXT:    calla cc_UC, callee
; CHECK-NEXT:    add r2, #1
; CHECK-NEXT:    ret
  %r = call i16 @callee(i16 %a, i16 1)
  %s = add i16 %r, 1
  ret i16 %s
}

