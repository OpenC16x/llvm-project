; Arguments beyond the four that go in registers would be written where the
; frame is about to stop being.
define i16 @stack_arguments(i16 %a) {
; CHECK-LABEL: stack_arguments:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov r3, #1
; CHECK-NEXT:    mov r4, #2
; CHECK-NEXT:    mov r5, #3
; CHECK-NEXT:    mov r6, #4
; CHECK-NEXT:    mov r7, #5
; CHECK-NEXT:    jmpa cc_UC, many
  %r = tail call i16 @many(i16 %a, i16 1, i16 2, i16 3, i16 4, i16 5)
  ret i16 %r
}

; Both ends have to be the same kind, since a near callee's RET would pop half
; of what a far caller left on the hardware stack and a far callee's RETS would
; pop a segment a near caller never pushed.
define i16 @to_far(i16 %a) {
; CHECK-LABEL: to_far:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    calls #seg(far_callee), sof(far_callee)
; CHECK-NEXT:    ret
  %r = tail call i16 @far_callee(i16 %a)
  ret i16 %r
}

define i16 @from_far(i16 %a) #1 {
; CHECK-LABEL: from_far:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    .cfi_escape 0x16, 0x2d, 0x0e, 0x92, 0x24, 0x02, 0x94, 0x02, 0x08, 0x10, 0x24, 0x92, 0x24, 0x00, 0x94, 0x02, 0x21 ; return address, from the hardware stack
; CHECK-NEXT:    .cfi_escape 0x16, 0x24, 0x03, 0x92, 0x24, 0x04 ; caller's hardware stack pointer
; CHECK-NEXT:    .cfi_escape 0x10, 0x2c, 0x03, 0x92, 0x24, 0x02 ; caller's CSP
; CHECK-NEXT:    mov r3, #1
; CHECK-NEXT:    calla cc_UC, callee
; CHECK-NEXT:    rets
  %r = tail call i16 @callee(i16 %a, i16 1)
  ret i16 %r
}

