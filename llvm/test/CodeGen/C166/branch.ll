; RUN: llc -mtriple=c166 -verify-machineinstrs < %s | FileCheck %s

; C166 has the full set of signed and unsigned condition codes, so every
; icmp maps onto a single cmp/jmpa pair.

define i16 @br_eq(i16 %a, i16 %b) {
; CHECK-LABEL: br_eq:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    cmp r2, r3
; CHECK-NEXT:    jmpr cc_NE, .LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %t
; CHECK-NEXT:    mov r2, #1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_2: ; %f
; CHECK-NEXT:    mov r2, #0
; CHECK-NEXT:    ret
entry:
  %c = icmp eq i16 %a, %b
  br i1 %c, label %t, label %f
t:
  ret i16 1
f:
  ret i16 0
}

