define i16 @loop(i16 %n) {
; CHECK-LABEL: loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov r3, r2
; CHECK-NEXT:    mov r2, #0
; CHECK-NEXT:    mov r4, #0
; CHECK-NEXT:    cmp r4, r3
; CHECK-NEXT:    jmpr cc_SGE, .LBB3_3
; CHECK-NEXT:  .LBB3_2: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add r2, r4
; CHECK-NEXT:    add r4, #1
; CHECK-NEXT:    cmp r4, r3
; CHECK-NEXT:    jmpr cc_SLT, .LBB3_2
; CHECK-NEXT:  .LBB3_3: ; %exit
; CHECK-NEXT:    ret
entry:
  br label %head
head:
  %i = phi i16 [ 0, %entry ], [ %i2, %body ]
  %s = phi i16 [ 0, %entry ], [ %s2, %body ]
  %c = icmp slt i16 %i, %n
  br i1 %c, label %body, label %exit
body:
  %s2 = add i16 %s, %i
  %i2 = add i16 %i, 1
  br label %head
exit:
  ret i16 %s
}

define void @indirect_branch(ptr %target) {
