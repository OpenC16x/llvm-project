; RUN: llc -mtriple=c166 -mattr=+mac -verify-machineinstrs < %s | FileCheck %s

; A summing loop leaves its total in the coprocessor: the CoLOAD is in the
; preheader, the CoSTOREs are past the exit, and what is left going round is
; the CoMAC on its own.
;
; The accumulator is one register pair shared by the whole part and saved by
; nothing, so the loops below that could lose it keep the round trip they
; started with.

@a = global [64 x i16] zeroinitializer
@b = global [64 x i16] zeroinitializer

define i32 @chained(i32 %n) {
; CHECK-LABEL: chained:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov r4, #0
; CHECK-NEXT:    mov r5, #1
; CHECK-NEXT:    mov r6, #1
; CHECK-NEXT:    cmp r3, #0
; CHECK-NEXT:    jmpr cc_SGE, .LBB0_7
; CHECK-NEXT:  ; %bb.1: ; %entry
; CHECK-NEXT:    cmp r2, #0
; CHECK-NEXT:    jmpr cc_NE, .LBB0_8
; CHECK-NEXT:  .LBB0_2: ; %entry
; CHECK-NEXT:    cmp r3, #0
; CHECK-NEXT:    jmpr cc_NE, .LBB0_9
; CHECK-NEXT:  .LBB0_3: ; %entry
; CHECK-NEXT:    jb r5.0, .LBB0_10
; CHECK-NEXT:  .LBB0_4: ; %body.preheader
; CHECK-NEXT:    mov r5, #b
; CHECK-NEXT:    coload r4, r4
; CHECK-NEXT:    mov r6, #0
; CHECK-NEXT:  .LBB0_5: ; %body
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov r7, r4
; CHECK-NEXT:    shl r7, #1
; CHECK-NEXT:    mov r8, #a
; CHECK-NEXT:    add r8, r7
; CHECK-NEXT:    add r7, r5
; CHECK-NEXT:    mov r7, [r7+#0]
; CHECK-NEXT:    mov r8, [r8+#0]
; CHECK-NEXT:    comac r8, r7
; CHECK-NEXT:    add r4, #1
; CHECK-NEXT:    addc r6, #0
; CHECK-NEXT:    mov r7, r6
; CHECK-NEXT:    xor r7, r3
; CHECK-NEXT:    mov r8, r4
; CHECK-NEXT:    xor r8, r2
; CHECK-NEXT:    or r8, r7
; CHECK-NEXT:    jmpr cc_NE, .LBB0_5
; CHECK-NEXT:  ; %bb.6:
; CHECK-NEXT:    costore r4, mal
; CHECK-NEXT:    costore r3, mah
; CHECK-NEXT:    mov r2, r4
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_7: ; %entry
; CHECK-NEXT:    mov r6, #0
; CHECK-NEXT:    cmp r2, #0
; CHECK-NEXT:    jmpr cc_EQ, .LBB0_2
; CHECK-NEXT:  .LBB0_8: ; %entry
; CHECK-NEXT:    mov r5, #0
; CHECK-NEXT:    cmp r3, #0
; CHECK-NEXT:    jmpr cc_EQ, .LBB0_3
; CHECK-NEXT:  .LBB0_9: ; %entry
; CHECK-NEXT:    mov r5, r6
; CHECK-NEXT:    jnb r5.0, .LBB0_4
; CHECK-NEXT:  .LBB0_10:
; CHECK-NEXT:    mov r3, #0
; CHECK-NEXT:    mov r2, r4
; CHECK-NEXT:    ret
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %body, label %done

body:
  %i = phi i32 [ %next, %body ], [ 0, %entry ]
  %acc = phi i32 [ %sum, %body ], [ 0, %entry ]
  %pa = getelementptr inbounds [64 x i16], ptr @a, i32 0, i32 %i
  %pb = getelementptr inbounds [64 x i16], ptr @b, i32 0, i32 %i
  %va = load i16, ptr %pa
  %vb = load i16, ptr %pb
  %sa = sext i16 %va to i32
  %sb = sext i16 %vb to i32
  %mul = mul nsw i32 %sa, %sb
  %sum = add nsw i32 %acc, %mul
  %next = add nuw nsw i32 %i, 1
  %at.end = icmp eq i32 %next, %n
  br i1 %at.end, label %done, label %body

done:
  %r = phi i32 [ 0, %entry ], [ %sum, %body ]
  ret i32 %r
}

; A call in the loop: the callee is free to multiply, and on a part with the
; coprocessor that is what multiplying uses.
declare void @sink(i32)

