entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %body, label %done

body:
  %i = phi i32 [ %next, %body ], [ 0, %entry ]
  %acc = phi i32 [ %sum, %body ], [ 0, %entry ]
  %pa = getelementptr inbounds [64 x i16], ptr @a, i32 0, i32 %i
  %pb = getelementptr inbounds [64 x i16], ptr @b, i32 0, i32 %i
  %va = load i16, ptr %pa
  %vb = load i16, ptr %pb
  %sa = sext i16 %va to i32
  %sb = sext i16 %vb to i32
  %mul = mul nsw i32 %sa, %sb
  %sum = add nsw i32 %acc, %mul
  call void @sink(i32 %sum)
  %next = add nuw nsw i32 %i, 1
  %at.end = icmp eq i32 %next, %n
  br i1 %at.end, label %done, label %body

done:
  %r = phi i32 [ 0, %entry ], [ %sum, %body ]
  ret i32 %r
}

; The running total is read inside the loop, so the register pair still has to
