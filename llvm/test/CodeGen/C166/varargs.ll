; CHECK-NEXT:    mov r2, #2
; CHECK-NEXT:    mov [r0+#2], r2
; CHECK-NEXT:    mov r2, #1
; CHECK-NEXT:    mov [r0], r2
; CHECK-NEXT:    calla cc_UC, variadic
; CHECK-NEXT:    add r0, #6
; CHECK-NEXT:    .cfi_def_cfa r0, 0
; CHECK-NEXT:    ret
  %r = call i16 (i16, ...) @variadic(i16 1, i16 2, i16 3)
  ret i16 %r
}
