; Several addressing modes come in a two byte and a four byte form.  A bare
; [Rw], a constant of 0 to 15 in a MOV and a constant of 0 to 7 in an
; arithmetic instruction all take the short one.

define i16 @load_indirect(ptr %p) {
; CHECK-LABEL: load_indirect:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov r2, [r2]
; CHECK-NEXT:    ret
  %v = load i16, ptr %p
  ret i16 %v
}

define void @store_indirect(ptr %p, i16 %v) {
; CHECK-LABEL: store_indirect:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov [r2], r3
; CHECK-NEXT:    ret
  store i16 %v, ptr %p
  ret void
}

define i16 @small_constant() {
; CHECK-LABEL: small_constant:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov r2, #15
; CHECK-NEXT:    ret
  ret i16 15
}

define i16 @constant_too_big() {
; CHECK-LABEL: constant_too_big:
