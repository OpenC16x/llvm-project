
#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// Infineon C166 relocations.
//
// There is no published psABI for C166 ELF, so this is the scheme LLVM's C166
// backend defines for itself.  Most addresses it emits are plain data: a 16
// bit near pointer stored little endian in the second word of an instruction,
// or an ordinary data word.
//
// The rest split a 24 bit address the way the segmented addressing modes need
// it, and correspond to the seg/sof/pag/pof operators the assembler accepts.
// Writing S for the symbol value and A for the addend:
//
//   R_C166_SEG8    ((S + A) >> 16) & 0xff, the segment for EXTS/JMPS/CALLS
//   R_C166_SOF16   (S + A) & 0xffff, the offset within that segment
//   R_C166_PAG10   ((S + A) >> 14) & 0x3ff, the page for EXTP
//   R_C166_POF14   (S + A) & 0x3fff, the offset within that page
//
// Each is written into a field of exactly that width; the linker is expected
// to check that the result fits.

ELF_RELOC(R_C166_NONE,      0)
ELF_RELOC(R_C166_ABS8,      1)
ELF_RELOC(R_C166_ABS16,     2)
ELF_RELOC(R_C166_ABS32,     3)
ELF_RELOC(R_C166_ABS64,     4)
ELF_RELOC(R_C166_PCREL8,    5)
ELF_RELOC(R_C166_PCREL16,   6)
ELF_RELOC(R_C166_PCREL32,   7)

// A relative branch displacement: (S + A - P) / 2 truncated to 8 bits, where
// P is the address of the instruction following the one being relocated.  Only
// the bit test branches need this.  JMPR counts words the same way but has a
// long form, so an assembler that cannot work out the distance grows it into
// that instead of leaving a relocation behind.
ELF_RELOC(R_C166_PCREL8W,  12)
ELF_RELOC(R_C166_SEG8,      8)
ELF_RELOC(R_C166_SOF16,     9)
ELF_RELOC(R_C166_PAG10,    10)
ELF_RELOC(R_C166_POF14,    11)

// A branch or call that does not leave the segment it is in - what the manual
// calls a "caddr".  The value written is (S + A) & 0xffff, the same as SOF16,
// and it is a relocation of its own so that the linker can check the one thing
// SOF16 cannot be checked for: the instruction takes its segment from CSP, so
// a target in another segment is not reached at all, and nothing in the
// instruction or in a plain SOF16 would say so.
ELF_RELOC(R_C166_CADDR16,  13)

// The 8 bit "bitoff" word address naming the word that holds a bit, which the
// bit instructions take instead of an address.  The mapping is not linear, so
// this cannot be an ABS8 of anything: 00H to 7FH is the internal RAM from
// FD00H in steps of a word, 80H to EFH is the special function registers from
// FF00H in steps of a word, and F0H to FFH is R0 to R15.  So the value written
// is
//
//   bitoff(S + A)  =  ((S + A) - FD00H) / 2          for FD00H..FDFEH
//                     80H + ((S + A) - FF00H) / 2    for FF00H..FFDEH
//
// and an address that is odd or in neither window names no bit-addressable
// word at all, which the linker is expected to say rather than truncate.
ELF_RELOC(R_C166_BITOFF8,  14)
